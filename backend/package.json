{
  "name": "loom-backend",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "predeploy": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "health-check": "node scripts/health-check.mjs",
    "tail": "wrangler tail",
    "types": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply loom-db --local",
    "migrate:prod": "wrangler d1 migrations apply loom-db --remote",
    "smoke:local": "node scripts/smoke.mjs local",
    "smoke:staging": "node scripts/smoke.mjs staging",
    "smoke:prod": "node scripts/smoke.mjs prod",
    "set-webhook": "npx tsx scripts/set-telegram-webhook.ts",
    "set-menu-button": "npx tsx scripts/set-menu-button.ts",
    "set-admin": "npx tsx scripts/set-admin.ts"
  },
  "dependencies": {
    "hono": "^4.5.0",
    "jose": "^5.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.152.0"
  }
}
